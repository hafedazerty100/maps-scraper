# =============================================================================
# maps-scraper — environment configuration
# Tuned defaults below are specifically for Render's FREE plan: 512MB RAM,
# 1 shared vCPU. Read the comments before changing anything — most of these
# values exist BECAUSE of that memory ceiling, not as arbitrary defaults.
# =============================================================================

# Port the API listens on inside the container.
# On Render this MUST match whatever Render auto-detects/you set — Render
# free web services listen on the $PORT Render injects, which is normally
# 10000. This app reads process.env.PORT automatically, so just leave this,
# Render will override it at runtime. Only matters for local docker-compose.
PORT=3000

# Required header for every request: x-api-key: <this value>
# This is a real, randomly generated key — ready to use, but you can
# regenerate your own any time with: openssl rand -hex 24
API_KEY=change_me_to_a_long_random_string # generate with: openssl rand -hex 24

# true = no visible browser window (required on a server/Docker — leave true)
HEADLESS=true

# Max concurrent Maps searches processed at once. MUST stay at 1 on a 512MB
# instance — a single headless Chromium session already uses a large chunk
# of your memory budget; two at once is a near-guaranteed crash.
MAX_CONCURRENCY=1

# Merges Chromium's browser + renderer into a single OS process instead of
# its normal multi-process model. This is the single biggest memory saving
# available (commonly 100-150MB) and is safe here because MAX_CONCURRENCY=1
# and the code never has more than one page open at a time. If you ever see
# mysterious mid-scrape browser crashes, set this to "false" first before
# changing anything else — the app also auto-retries without it if the
# initial launch itself fails.
CHROME_SINGLE_PROCESS=true

# Caps the memory Chromium's JS engine (V8) is allowed to use per page.
# Keep this well below your container's total RAM. 256 is a safe number for
# a 512MB box once combined with the Docker-level NODE_OPTIONS cap.
RENDERER_HEAP_MB=256

# Hard ceiling (ms) on a single scrape job. If a job runs longer than this,
# the browser is force-killed and the request fails cleanly instead of
# hanging until Render's proxy or n8n's own timeout eventually gives up with
# no cleanup. IMPORTANT: set your n8n HTTP Request node's timeout HIGHER
# than this value (e.g. 120000ms) or n8n will cut the connection first.
JOB_TIMEOUT_MS=100000

# Optional. Route all browser traffic through a proxy, format:
# http://user:pass@host:port
# Leave empty to scrape directly from Render's own IP. Google WILL eventually
# rate-limit/flag a shared Render IP if you run high volumes — a proxy is the
# fix for that, not something this app can work around on its own.
PROXY_SERVER=

# Default max results per Maps search if the request doesn't specify one.
# /scrape-leads is now lightweight (name + mapsUrl only, no detail panes or
# website visits — see README), so this can be higher than before without
# risking the memory ceiling. Loop /enrich-lead calls afterwards to fill in
# details for however many of these you actually want to enrich.
DEFAULT_LIMIT=15

# Max results per request, hard ceiling regardless of what's requested.
MAX_LIMIT=40
